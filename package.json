{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm --prefix server start",
    "server:build": "npm --prefix server run build",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:models": "node scripts/verify-models.mjs",
    "test:imported-models": "python3 scripts/verify-imported-vehicles.py",
    "test:vfx": "node scripts/verify-vfx.mjs",
    "test:scenery": "node scripts/verify-scenery.mjs",
    "test:battle": "node scripts/verify-battle-performance.mjs",
    "test:match": "node scripts/verify-match-rules.mjs",
    "lint:app": "oxlint src scripts vite.config.ts",
    "test:race": "node scripts/verify-race.mjs",
    "test:race:network": "node scripts/verify-race-network.mjs",
    "prepare:vehicles": "node scripts/prepare-downloaded-vehicles.mjs",
    "test:audio": "node scripts/verify-audio.mjs",
    "prepare:projectiles": "node scripts/prepare-projectiles.mjs",
    "test:projectiles": "node scripts/verify-projectiles.mjs",
    "test:rooms": "npm --prefix server run build && node scripts/verify-rooms.mjs",
    "test:setup": "node scripts/verify-setup.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/gui": "^9.28.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.28.0",
    "@babylonjs/materials": "^9.30.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^0.25.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
